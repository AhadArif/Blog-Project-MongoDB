<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - BlogNest</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav>
        <ul>
            <li class="<%= isActiveRoute('/', currentRoute) %>"><a href="/">Home</a></li>
            <li class="<%= isActiveRoute('/contact', currentRoute) %>"><a href="/contact">Contact</a></li>
        </ul>
    </nav>
    <div class="container">
        <h1>Contact Us</h1>
        <p>You can contact us at <a href="mailto:abdul.ahad@cmr.edu.in">abdul.ahad@cmr.edu.in</a></p>
        <form action="/contact" method="POST">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>

            <label for="message">Message:</label>
            <textarea id="message" name="message" rows="6" required></textarea>

            <input type="submit" value="Send Message">
        </form>
    </div>
</body>
</html>
